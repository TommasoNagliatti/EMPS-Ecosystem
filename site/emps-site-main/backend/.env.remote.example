# Copy to .env.remote (ignored), then fill privately AFTER an SSH audit.
# This template cannot start: target identity and credentials are deliberately blank.
NODE_ENV=development
HOST=127.0.0.1
PORT=3011
EMPS_REMOTE_SITE_PORT=3010
EMPS_REMOTE_TUNNEL_PORT=3317
EMPS_REMOTE_DEVELOPMENT=true
EMPS_REMOTE_ACCESS_MODE=READ_ONLY
EMPS_REMOTE_ENVIRONMENT=hostinger-read-only
EMPS_BACKGROUND_JOBS_ENABLED=false
EMPS_PHYSICAL_COMMANDS_ENABLED=false
EMPS_EXTERNAL_PAYMENT_SIDE_EFFECTS_ENABLED=false
EMPS_REMOTE_EXPECTED_DATABASE=
EMPS_REMOTE_EXPECTED_SERVER_UUID=
EMPS_REMOTE_ALLOWED_EMAILS=
DATABASE_URL=
JWT_SECRET=
JWT_EXPIRES_IN=15m
CORS_ORIGINS=http://localhost:3010,http://127.0.0.1:3010
PAYMENT_PROVIDER=sandbox
# Local SSH alias with independently verified known_hosts entry.
EMPS_REMOTE_SSH_HOST=
# Exact private endpoint confirmed by docker inspect on the VPS.
EMPS_REMOTE_MYSQL_HOST=
EMPS_REMOTE_MYSQL_PORT=
# Optional isolated replay only. Never enables GIE operational writes or commands.
EMPS_LOCAL_GIE_DEMO=false
EMPS_LOCAL_GIE_STATION_ID=
EMPS_LOCAL_GIE_PORT=8013
EMPS_LOCAL_GIE_TOKEN=
