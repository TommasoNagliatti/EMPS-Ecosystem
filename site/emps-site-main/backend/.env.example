# MySQL local iniciado pelo docker-compose.yml da raiz.
DATABASE_URL="mysql://emps:emps_local@localhost:3306/emps_db"

# Gere um valor aleatório próprio. Nunca reutilize este exemplo em produção.
JWT_SECRET="replace-with-at-least-32-random-characters"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_DAYS=30
# Sessão do painel: renovada a cada uso, com até 1 ano de inatividade.
WEB_REFRESH_TOKEN_DAYS=365
CHARGER_ACTIVATION_DAYS=7
PORT=3001

# Origens de navegador, separadas por vírgula. Para abrir o painel na LAN,
# acrescente http://IP-DO-COMPUTADOR:3000. Apps nativos não usam localhost.
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# Funciona localmente sem movimentar dinheiro.
# Use "stripe" somente depois de configurar cliente, credenciais e webhook.
PAYMENT_PROVIDER="sandbox"
# STRIPE_SECRET_KEY="YOUR_STRIPE_TEST_SECRET"
# STRIPE_WEBHOOK_SECRET="YOUR_LOCAL_WEBHOOK_SECRET"

# Sem URL, comandos são aceitos pelo simulador local e registrados no banco,
# mas nenhum carregador físico é liberado.
# OCPP_GATEWAY_URL="https://csms.exemplo.com"
# OCPP_GATEWAY_TOKEN="replace-with-gateway-token"

# Opt-in: somente novas sessões da estação habilitada recebem SP_ENEL_PROTO_V1.
# IDs das estações locais que devem usar a V1 (vazio mantém o opt-in desativado).
TARIFF_V1_STATION_IDS=
# Opcional: instante de ativação para separar sessões legadas.
TARIFF_V1_ACTIVATED_AT=
GIE_STATION_ID=1
GIE_SERVICE_URL=http://127.0.0.1:8510
GIE_SERVICE_TOKEN=replace-with-private-token-at-least-24-characters
GIE_NORMAL_DEMO=true
GIE_WEATHER_ENABLED=true
