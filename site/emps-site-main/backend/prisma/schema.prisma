  id                          BigInt                                      @id @default(autoincrement()) @db.UnsignedBigInt
  stationId                   Int                                         @map("station_id") @db.UnsignedInt
  measuredAt                  DateTime                                    @map("measured_at")
  receivedAt                  DateTime                                    @default(now()) @map("received_at")
  sequenceNumber              BigInt?                                     @map("sequence_number") @db.UnsignedBigInt
  measurementQuality          station_energy_readings_measurement_quality @default(UNKNOWN) @map("measurement_quality")
  gridPowerKw                 Decimal?                                    @map("grid_power_kw") @db.Decimal(10, 3)
  solarPowerKw                Decimal?                                    @map("solar_power_kw") @db.Decimal(10, 3)
  batteryPowerKw              Decimal?                                    @map("battery_power_kw") @db.Decimal(10, 3)
  batteryChargePowerKw        Decimal?                                    @map("battery_charge_power_kw") @db.Decimal(10, 3)
  batteryDischargePowerKw     Decimal?                                    @map("battery_discharge_power_kw") @db.Decimal(10, 3)
  chargerPowerKw              Decimal?                                    @map("charger_power_kw") @db.Decimal(10, 3)
  chargerRequestedPowerKw     Decimal?                                    @map("charger_requested_power_kw") @db.Decimal(10, 3)
  buildingPowerKw             Decimal?                                    @map("building_power_kw") @db.Decimal(10, 3)
  outsideTemperatureC         Decimal?                                    @map("outside_temperature_c") @db.Decimal(6, 2)
  relativeHumidityPercent     Decimal?                                    @map("relative_humidity_percent") @db.Decimal(5, 2)
  connectedVehicleCount       Int?                                        @map("connected_vehicle_count") @db.UnsignedTinyInt
  queuedVehicleCount          Int?                                        @map("queued_vehicle_count") @db.UnsignedTinyInt
  batteryStateOfChargePercent Decimal?                                    @map("battery_state_of_charge_percent") @db.Decimal(5, 2)
  readingSource               station_energy_readings_reading_source      @map("reading_source")
  createdAt                   DateTime                                    @default(now()) @map("created_at") @db.Timestamp(0)
  stations                    Station                                     @relation(fields: [stationId], references: [id], map: "fk_station_energy_station")

  @@index([stationId, measuredAt], map: "idx_station_energy_time")
  @@map("station_energy_readings")
}

model StationStaff {
  stationId  Int       @map("station_id") @db.UnsignedInt
  userId     Int       @map("user_id") @db.UnsignedInt
  staffRole  StaffRole @default(OPERATOR) @map("staff_role")
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamp(0)
  station    Station   @relation(fields: [stationId], references: [id], onDelete: Cascade, map: "fk_station_staff_station")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_station_staff_user")

  @@id([stationId, userId])
  @@index([userId], map: "idx_station_staff_user")
  @@map("station_staff")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Station {
  id                    Int                    @id @default(autoincrement()) @db.UnsignedInt
  adminId               Int                    @map("admin_id") @db.UnsignedInt
  name                  String                 @map("station_name") @db.VarChar(50)
  postalCode            String                 @map("postal_code") @db.Char(8)
  street                String                 @db.VarChar(80)
  addressNumber         String                 @map("address_number") @db.VarChar(20)
  complement            String?                @db.VarChar(80)
  neighborhood          String                 @db.VarChar(80)
  city                  String                 @db.VarChar(80)
  state                 String                 @db.Char(2)
  countryCode           String                 @default("BR") @map("country_code") @db.Char(2)
  latitude              Decimal?               @db.Decimal(10, 8)
  longitude             Decimal?               @db.Decimal(11, 8)
  timezone              String                 @default("America/Sao_Paulo") @map("timezone_name") @db.VarChar(50)
  openingHours          String?                @map("opening_hours") @db.VarChar(100)
  featured              Boolean                @default(false)
  geocodingStatus       GeocodingStatus        @default(PENDING) @map("geocoding_status")
  powerLimitKw          Decimal?               @map("power_limit_kw") @db.Decimal(10, 2)
  status                StationStatus          @default(PENDING)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  alerts                Alert[]
  chargers              Charger[]
  gieCycles             GieCycle[]
  gieEvseMappings       GieEvseMapping[]
  gieIntervalSnapshots  GieIntervalSnapshot[]
  amenities             StationAmenity[]
  stationEnergyReadings StationEnergyReading[]
  staff                 StationStaff[]
  admin                 User                   @relation(fields: [adminId], references: [id], map: "fk_stations_admin")
  tariffs               Tariff[]

  @@index([adminId], map: "fk_stations_admin")
  @@index([latitude, longitude], map: "idx_stations_coordinates")
  @@map("stations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Tariff {
  id                    Int               @id @default(autoincrement()) @db.UnsignedInt
  stationId             Int               @map("station_id") @db.UnsignedInt
  chargerId             Int?              @map("charger_id") @db.UnsignedInt
  name                  String            @map("tariff_name") @db.VarChar(100)
  basePricePerKwh       Decimal           @map("base_price_per_kwh") @db.Decimal(10, 4)
  fixedFee              Decimal           @default(0.00) @map("fixed_fee") @db.Decimal(10, 2)
  dynamicPricingEnabled Boolean           @default(true) @map("dynamic_pricing_enabled")
  demandThreshold       Decimal           @default(0.6000) @map("demand_threshold") @db.Decimal(5, 4)
  maxDynamicAdjustment  Decimal           @default(0.3000) @map("max_dynamic_adjustment") @db.Decimal(5, 4)
  currency              String            @default("BRL") @map("currency_code") @db.Char(3)
  validFrom             DateTime          @map("valid_from") @db.DateTime(0)
  validUntil            DateTime?         @map("valid_until") @db.DateTime(0)
  status                TariffStatus      @default(SCHEDULED)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  chargingSessions      ChargingSession[]
  paymentIntents        PaymentIntent[]
  charger               Charger?          @relation(fields: [chargerId], references: [id], onDelete: Restrict, map: "fk_tariffs_charger")
  station               Station           @relation(fields: [stationId], references: [id], map: "fk_tariffs_station")

  @@index([chargerId, status], map: "idx_tariffs_charger_status")
  @@index([stationId, status], map: "idx_tariffs_station_status")
  @@map("tariffs")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model RefreshToken {
  id         BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  userId     Int           @map("user_id") @db.UnsignedInt
  tokenHash  String        @unique(map: "token_hash") @map("token_hash") @db.Char(64)
  familyId   String        @map("token_family") @db.Char(36)
  deviceName String?       @map("device_name") @db.VarChar(100)
  platform   TokenPlatform @default(UNKNOWN)
  expiresAt  DateTime      @map("expires_at") @db.DateTime(0)
  revokedAt  DateTime?     @map("revoked_at") @db.DateTime(0)
  lastUsedAt DateTime?     @map("last_used_at") @db.DateTime(0)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_refresh_tokens_user")

  @@index([expiresAt, revokedAt], map: "idx_refresh_tokens_expiration")
  @@index([familyId], map: "idx_refresh_tokens_family")
  @@index([userId], map: "idx_refresh_tokens_user")
  @@map("user_refresh_tokens")
}

model UserVehicle {
  id                  Int           @id @default(autoincrement()) @db.UnsignedInt
  userId              Int           @map("user_id") @db.UnsignedInt
  manufacturer        String?       @db.VarChar(80)
  model               String        @db.VarChar(100)
  licensePlate        String        @unique(map: "license_plate") @map("license_plate") @db.VarChar(10)
  connectorPreference String?       @map("connector_preference") @db.VarChar(50)
  isPrimary           Boolean       @default(false) @map("is_primary")
  status              VehicleStatus @default(ACTIVE)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_vehicles_user")

  @@index([userId], map: "idx_user_vehicles_user")
  @@map("user_vehicles")
}

model User {
  id               Int               @id @default(autoincrement()) @db.UnsignedInt
  name             String            @map("full_name") @db.VarChar(100)
  email            String            @unique(map: "email") @db.VarChar(255)
  phone            String?           @db.VarChar(20)
  passwordHash     String            @map("password_hash") @db.VarChar(255)
  role             Role              @default(CUSTOMER)
  accountStatus    AccountStatus     @default(ACTIVE) @map("account_status")
  emailVerifiedAt  DateTime?         @map("email_verified_at") @db.DateTime(0)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  alerts           Alert[]
  chargingCommands ChargingCommand[]
  sessions         ChargingSession[] @relation("charging_sessions_customer_idTousers")
  startedSessions  ChargingSession[] @relation("charging_sessions_started_by_user_idTousers")
  paymentIntents   PaymentIntent[]
  stationStaff     StationStaff[]
  stations         Station[]
  refreshTokens    RefreshToken[]
  vehicles         UserVehicle[]

  @@index([role, accountStatus], map: "idx_users_role_status")
  @@map("users")
}

