/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Alert {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  stationId        Int?             @map("station_id") @db.UnsignedInt
  chargerId        Int?             @map("charger_id") @db.UnsignedInt
  sessionId        BigInt?          @map("charging_session_id") @db.UnsignedBigInt
  alertType        String           @map("alert_type") @db.VarChar(100)
  title            String           @db.VarChar(150)
  description      String           @db.Text
  severity         AlertSeverity
  status           AlertStatus      @default(OPEN)
  alertSource      AlertSource      @map("alert_source")
  errorCode        String?          @map("error_code") @db.VarChar(100)
  resolvedByUserId Int?             @map("resolved_by_user_id") @db.UnsignedInt
  resolvedAt       DateTime?        @map("resolved_at") @db.DateTime(0)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  charger          Charger?         @relation(fields: [chargerId], references: [id], map: "fk_alerts_charger")
  resolvedBy       User?            @relation(fields: [resolvedByUserId], references: [id], map: "fk_alerts_resolved_by")
  session          ChargingSession? @relation(fields: [sessionId], references: [id], map: "fk_alerts_session")
  station          Station?         @relation(fields: [stationId], references: [id], map: "fk_alerts_station")

  @@index([resolvedByUserId], map: "fk_alerts_resolved_by")
  @@index([sessionId], map: "fk_alerts_session")
  @@index([chargerId, status], map: "idx_alerts_charger_status")
  @@index([severity, status], map: "idx_alerts_severity_status")
  @@index([stationId, status], map: "idx_alerts_station_status")
  @@map("alerts")
}

