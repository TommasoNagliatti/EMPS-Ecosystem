{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emps:energy:v1",
  "title": "EMPS Serial-only energy snapshot",
  "type": "object",
  "required": [
    "type",
    "schemaVersion",
    "stationId",
    "gieStationId",
    "generation",
    "revision",
    "source",
    "valid",
    "errors",
    "scenarioAt",
    "observedAt",
    "emittedAt",
    "expiresAt",
    "emittedAtMs",
    "expiresAtMs",
    "commandId",
    "sequence",
    "channelId",
    "bootId",
    "ttlMs",
    "mode",
    "hardwareApproved",
    "electricalSafe",
    "physicalMeasurement",
    "evses",
    "battery",
    "solar",
    "grid",
    "building",
    "balance",
    "provenance"
  ],
  "properties": {
    "type": {
      "const": "energy.snapshot"
    },
    "schemaVersion": {
      "const": "emps.energy.v1"
    },
    "stationId": {
      "enum": [
        "13",
        "46"
      ]
    },
    "gieStationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source": {
      "const": "SIMULATED"
    },
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarioAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "observedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "emittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "emittedAtMs": {
      "type": "number"
    },
    "expiresAtMs": {
      "type": "number"
    },
    "commandId": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "channelId": {
      "type": "string",
      "format": "uuid"
    },
    "bootId": {
      "type": "string",
      "pattern": "^(sim|esp)_[A-Za-z0-9_-]{1,55}$"
    },
    "ttlMs": {
      "const": 4000
    },
    "mode": {
      "const": "SERIAL_ONLY"
    },
    "hardwareApproved": {
      "const": false
    },
    "electricalSafe": {
      "const": false
    },
    "physicalMeasurement": {
      "const": false
    },
    "evses": {
      "type": "object",
      "required": [
        "EV1",
        "EV2"
      ],
      "additionalProperties": false,
      "properties": {
        "EV1": {
          "$ref": "#/$defs/evse"
        },
        "EV2": {
          "$ref": "#/$defs/evse"
        }
      }
    },
    "battery": {
      "type": "object",
      "required": [
        "socMeanPct",
        "BAT_01",
        "BAT_02",
        "chargeKw",
        "dischargeKw"
      ],
      "properties": {
        "socMeanPct": {
          "$ref": "#/$defs/soc"
        },
        "BAT_01": {
          "$ref": "#/$defs/battery"
        },
        "BAT_02": {
          "$ref": "#/$defs/battery"
        },
        "chargeKw": {
          "$ref": "#/$defs/power"
        },
        "dischargeKw": {
          "$ref": "#/$defs/power"
        }
      }
    },
    "solar": {
      "type": "object",
      "required": [
        "generatedKw",
        "usedKw",
        "curtailedKw",
        "active",
        "ledGpio"
      ],
      "properties": {
        "generatedKw": {
          "$ref": "#/$defs/power"
        },
        "usedKw": {
          "$ref": "#/$defs/power"
        },
        "curtailedKw": {
          "$ref": "#/$defs/power"
        },
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ledGpio": {
          "const": null
        }
      }
    },
    "grid": {
      "type": "object",
      "required": [
        "importKw",
        "exportKw"
      ],
      "properties": {
        "importKw": {
          "$ref": "#/$defs/power"
        },
        "exportKw": {
          "$ref": "#/$defs/power"
        }
      }
    },
    "building": {
      "type": "object",
      "required": [
        "consumptionKw",
        "lightOn"
      ],
      "properties": {
        "consumptionKw": {
          "$ref": "#/$defs/power"
        },
        "lightOn": {
          "const": true
        }
      }
    },
    "balance": {
      "type": "object",
      "required": [
        "supplyKw",
        "consumptionKw",
        "residualKw",
        "toleranceKw",
        "modeledLossesKw",
        "lossesModeled",
        "basis"
      ],
      "properties": {
        "supplyKw": {
          "$ref": "#/$defs/power"
        },
        "consumptionKw": {
          "$ref": "#/$defs/power"
        },
        "residualKw": {
          "type": [
            "number",
            "null"
          ]
        },
        "toleranceKw": {
          "type": "number",
          "minimum": 0
        },
        "modeledLossesKw": {
          "$ref": "#/$defs/power"
        },
        "lossesModeled": {
          "type": "boolean"
        },
        "basis": {
          "const": "AC_BUS_KW_SOLAR_USED"
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "presentation": {
      "type": "object",
      "properties": {
        "source": {
          "const": "ILLUSTRATIVE_ONLY"
        },
        "participatesInBalance": {
          "const": false
        },
        "solarSharePct": {
          "enum": [
            80,
            null
          ]
        },
        "gridSharePct": {
          "enum": [
            20,
            null
          ]
        },
        "gieMode": {
          "type": "string"
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "power": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "soc": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "battery": {
      "type": "object",
      "required": [
        "socPct",
        "chargeKw",
        "dischargeKw"
      ],
      "properties": {
        "socPct": {
          "$ref": "#/$defs/soc"
        },
        "chargeKw": {
          "$ref": "#/$defs/power"
        },
        "dischargeKw": {
          "$ref": "#/$defs/power"
        }
      }
    },
    "evse": {
      "type": "object",
      "required": [
        "gieAuthorized",
        "allocatedKw",
        "sessionAuthorized",
        "sessionId",
        "sessionExpiresAt",
        "operationalAuthorized",
        "authorizationId",
        "effectiveRelay",
        "blockedReason"
      ],
      "properties": {
        "gieAuthorized": {
          "type": "boolean"
        },
        "allocatedKw": {
          "$ref": "#/$defs/power"
        },
        "sessionAuthorized": {
          "type": "boolean"
        },
        "sessionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sessionExpiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "operationalAuthorized": {
          "type": "boolean"
        },
        "authorizationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "effectiveRelay": {
          "const": false
        },
        "blockedReason": {
          "const": "HARDWARE_NOT_APPROVED"
        },
        "chargerId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "chargerCode": {
          "type": "string"
        },
        "gieEvse": {
          "type": "string"
        },
        "chargingRequested": {
          "type": "boolean"
        },
        "sessionExpiresAtMs": {
          "type": [
            "number",
            "null"
          ]
        },
        "sessionSource": {
          "const": "EXISTING_LAB_CHARGE_SESSION"
        }
      }
    }
  }
}
