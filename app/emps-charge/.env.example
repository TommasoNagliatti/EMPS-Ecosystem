# Produção: use a API pública HTTPS oficial.
# Em desenvolvimento no celular físico, use um IPv4 LAN ou túnel HTTPS; nunca localhost.
# O mapa OpenStreetMap não exige chave de API.
EXPO_PUBLIC_EMPS_API_URL=https://api.emps-charge.tech

# O padrão usa a API real. Mude para true somente para apresentação sem backend.
EXPO_PUBLIC_EMPS_DEMO_MODE=false

# Necessária somente para confirmar pagamentos Stripe Sandbox pelo PaymentSheet.
# Use apenas a chave publicável (pk_test_...), nunca a chave secreta.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
